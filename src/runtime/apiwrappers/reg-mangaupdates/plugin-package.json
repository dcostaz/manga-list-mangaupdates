{
  "pluginName": "mangaupdates",
  "pluginType": "tracker",
  "pluginContractVersion": "2.0.0",
  "hostApiVersion": "1.0.0",
  "iconPath": "images/mangaupdates-icon.svg",
  "capabilities": ["credential", "search.query", "search.lookup", "enrich", "enrich.cover", "sync.pull", "sync.push", "sync.list", "subscribe.add", "subscribe.remove", "plugin.live"],
  "entrypoints": {
    "pluginModule": "apiwrappers/reg-mangaupdates/plugin-module.cjs",
    "settingsFile": "apiwrappers/reg-mangaupdates/mangaupdates-api-settings.json"
  },
  "syncOptions": {
    "searchRequiresAuth": true,
    "statusVocabulary": {
      "READING":      "reading",
      "COMPLETED":    "complete",
      "PLAN_TO_READ": "wish",
      "ON_HOLD":      "hold",
      "DROPPED":      "dropped",
      "RE_READING":   null
    },
    "supportedActions": []
  }
}
